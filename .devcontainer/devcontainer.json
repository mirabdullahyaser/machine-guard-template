{
  "name": "Machine Guard (MLOps from Zero to Live)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 2
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "helm": "none",
      "minikube": "none"
    },
    "ghcr.io/devcontainers-extra/features/kind:1": {}
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && python scripts/download_data.py",
  "waitFor": "postCreateCommand",
  "forwardPorts": [
    5000,
    8000,
    8501,
    8080,
    4200
  ],
  "portsAttributes": {
    "5000": {
      "label": "MLflow UI (Day 2)"
    },
    "8000": {
      "label": "FastAPI (Day 3)"
    },
    "8501": {
      "label": "Streamlit (Day 3)"
    },
    "8080": {
      "label": "Kubernetes (kind, Day 3)"
    },
    "4200": {
      "label": "Prefect UI (Day 4, optional)"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "marp-team.marp-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    }
  }
}
